<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#164e3a"><title>LDL Daily Essentials</title><style>:root{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#19382c;background:#f4f7f4}*{box-sizing:border-box}body{margin:0;padding:18px}main{max-width:650px;margin:auto}header{background:#164e3a;color:white;border-radius:18px;padding:22px}h1{font-size:25px;margin:0 0 7px}h2{font-size:18px;margin:0 0 12px}p{margin:6px 0;line-height:1.45}.sub{opacity:.85;font-size:13px}.progress{height:9px;background:#b6c9be;border-radius:8px;overflow:hidden;margin-top:14px}.fill{height:100%;width:0;background:#90e4b1}.panel{background:white;border-radius:16px;padding:18px;margin-top:15px;box-shadow:0 1px 7px #173d2412}.item{display:flex;gap:12px;padding:12px 0;border-top:1px solid #edf0ed;align-items:flex-start}.item:first-of-type{border:0}input[type=checkbox]{width:22px;height:22px;accent-color:#21734c;flex:none;margin:2px 0}strong{display:block;font-size:15px}small{display:block;color:#63756b;font-size:13px;line-height:1.4;margin-top:3px}.controls{display:flex;gap:9px;flex-wrap:wrap;margin:14px 0}button{border:1px solid #9fb9a9;border-radius:10px;padding:11px 13px;background:white;color:#164e3a;font-weight:600;font-size:14px}button.primary{background:#164e3a;color:white}.note{font-size:13px;color:#52665b;line-height:1.5}.weekly{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stat{background:#f1f7f2;border-radius:10px;padding:12px}.stat b{font-size:20px;display:block}.history-row{display:flex;justify-content:space-between;border-top:1px solid #edf0ed;padding:9px 0;font-size:13px}#status{font-size:12px;color:#516f5e}@media print{body{background:white;padding:0}.controls,.note.no-print{display:none}header{color:black;background:white;border:1px solid #aaa}.panel{box-shadow:none;border:1px solid #ddd;break-inside:avoid}.item{padding:8px 0}button{display:none}}</style></head><body><main><header><h1>LDL Daily Essentials</h1><p class="sub">10 sustainable habits · Your daily heart-health checklist</p><p id="today"></p><p><b id="count">0</b> / 10 completed</p><div class="progress"><div class="fill" id="bar"></div></div></header><section class="panel"><h2>🥗 Dietary essentials</h2><div id="diet"></div></section><section class="panel"><h2>🚴 Lifestyle essentials</h2><div id="life"></div></section><section class="panel"><h2>Weekly perspective</h2><div class="weekly"><div class="stat"><small>Moderate aerobic exercise</small><b id="aerobic">0 / 150 min</b><small>Weekly minimum target</small></div><div class="stat"><small>Gym sessions</small><b id="gym">0 / 3</b><small>Rest days count as recovery</small></div></div><p class="note">Use the lifestyle checklist flexibly. Weekly activity totals matter more than perfect daily scores.</p><div class="controls"><button id="addAerobic">+ 15 aerobic min</button><button id="addGym">+ 1 gym session</button><button id="undoAerobic">− 15 min</button><button id="undoGym">− 1 gym</button></div></section><section class="panel"><h2>Recent days</h2><div id="history"></div><p class="note">Your entries are stored on this device when browser storage is available. Export backups periodically; clearing website data can erase them.</p></section><div class="controls"><button class="primary" onclick="window.print()">Print / Save PDF</button><button id="export">Export CSV history</button><button id="clear">Clear today's checks</button></div><p id="status">Checklist works without internet. Automatic saving requires a browser with local storage.</p><p class="note no-print">Your LDL goals: first work toward 110 mg/dL and reassess after 8–12 weeks. This is a habit tracker, not a medical risk score. You do not need to achieve 10/10 every day.</p></main><script>
const items=[['Viscous soluble fiber','Oats, barley or psyllium in meaningful portions'],['Legumes and soy','Natto, tofu, lentils, chickpeas or beans'],['Nuts and seeds','Around 25–30 g nuts; optional ground flaxseed'],['Healthy fat substitutions','Choose unsaturated fats instead of butter, cream or fatty meats'],['Fruit and vegetables','Whole fruit and vegetables across meals'],['Aerobic activity','Aim for 30–45 minutes of brisk walking, cycling or similar activity'],['Daily movement','Break up prolonged sitting; keep walking throughout the day'],['Resistance training','Complete your planned gym session, or recover on rest days'],['Sleep and recovery','Aim for 7–9 hours of sleep with a consistent bedtime'],['Weight-management habits','Avoid habitual evening snacking; support gradual weight loss']];
const localDate=()=>{let d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};const weekKey=()=>{let d=new Date();let day=(d.getDay()+6)%7;d.setDate(d.getDate()-day);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};let data={days:{},weeks:{}};try{data=JSON.parse(localStorage.getItem('ldlEssentialsV1')||'{}');data.days ||= {};data.weeks ||= {}}catch(e){data={days:{},weeks:{}}}let day=localDate(),week=weekKey();data.days[day] ||= [];data.weeks[week] ||= {aerobic:0,gym:0};const save=()=>{try{localStorage.setItem('ldlEssentialsV1',JSON.stringify(data));document.getElementById('status').textContent='Saved locally on this device.'}catch(e){document.getElementById('status').textContent='Local saving unavailable in this viewer; use Safari on a hosted webpage for reliable saving.'}};
function render(){document.getElementById('today').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric',year:'numeric'});['diet','life'].forEach((id,group)=>{let el=document.getElementById(id);el.innerHTML='';for(let i=group*5;i<group*5+5;i++){let label=document.createElement('label');label.className='item';let check=document.createElement('input');check.type='checkbox';check.checked=data.days[day].includes(i);check.addEventListener('change',()=>{let a=data.days[day];data.days[day]=check.checked?[...new Set([...a,i])]:a.filter(x=>x!==i);save();update()});let content=document.createElement('span');let name=document.createElement('strong');name.textContent=items[i][0];let desc=document.createElement('small');desc.textContent=items[i][1];content.append(name,desc);label.append(check,content);el.append(label)}});update()}
function update(){let n=data.days[day].length;document.getElementById('count').textContent=n;document.getElementById('bar').style.width=n*10+'%';document.getElementById('aerobic').textContent=data.weeks[week].aerobic+' / 150 min';document.getElementById('gym').textContent=data.weeks[week].gym+' / 3';let entries=Object.entries(data.days).sort((a,b)=>b[0].localeCompare(a[0])).slice(0,14);document.getElementById('history').innerHTML=entries.map(([d,arr])=>`<div class="history-row"><span>${d}</span><b>${arr.length} / 10</b></div>`).join('')}
for(let [id,key,delta] of [['addAerobic','aerobic',15],['undoAerobic','aerobic',-15],['addGym','gym',1],['undoGym','gym',-1]])document.getElementById(id).onclick=()=>{data.weeks[week][key]=Math.max(0,data.weeks[week][key]+delta);save();update()};document.getElementById('clear').onclick=()=>{if(confirm('Clear today\'s checks?')){data.days[day]=[];save();render()}};document.getElementById('export').onclick=()=>{let rows=[['Date',...items.map(x=>x[0]),'Total']];for(let [d,a] of Object.entries(data.days).sort())rows.push([d,...items.map((_,i)=>a.includes(i)?'1':'0'),String(a.length)]);let csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\r\n');let blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'});let url=URL.createObjectURL(blob);let link=document.createElement('a');link.href=url;link.download='ldl-food-history.csv';document.body.append(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)};render();save();
</script></body></html>
